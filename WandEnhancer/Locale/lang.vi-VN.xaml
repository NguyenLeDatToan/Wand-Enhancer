<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--#region Language Metadata -->
    <s:String x:Key="language_display_name">Tiếng Việt</s:String>
    <!--#endregion -->

    <!--#region MainWindow -->
    <s:String x:Key="mw_folder_path">Đường dẫn thư mục</s:String>
    <s:String x:Key="mw_folder_not_found">Không tìm thấy thư mục</s:String>
    <s:String x:Key="mw_patch">Nâng cấp</s:String>
    <s:String x:Key="mw_restore">Hoàn nguyên</s:String>
    <s:String x:Key="mw_source_code">Mã nguồn</s:String>
    <s:String x:Key="mw_made_by">Được làm với ❤️ bởi k1tbyte</s:String>
    <s:String x:Key="mw_star_hint">Đặt star nếu thấy hữu ích nha ;)</s:String>
    <s:String x:Key="mw_copy_logs">Sao chép log vào bộ nhớ tạm</s:String>
    <s:String x:Key="mw_export_logs">Xuất log ra file</s:String>
    <s:String x:Key="mw_update_badge">Đã có phiên bản mới</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">Cài đặt</s:String>
    <s:String x:Key="settings_language">Ngôn ngữ</s:String>
    <s:String x:Key="settings_check_updates">Kiểm tra cập nhật khi khởi động</s:String>
    <s:String x:Key="settings_check_prereleases">Cũng thông báo bản dựng thử (pre-release)</s:String>
    <s:String x:Key="settings_save">Lưu</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">Đã có bản cập nhật</s:String>
    <s:String x:Key="up_warning">WandEnhancer không tự cập nhật. Hãy tự build phiên bản mới trong fork của bạn, hoặc mở trang phát hành.</s:String>
    <s:String x:Key="up_current_version">Hiện tại:</s:String>
    <s:String x:Key="up_latest_version">Mới nhất:</s:String>
    <s:String x:Key="up_release_notes">Ghi chú phát hành</s:String>
    <s:String x:Key="up_show_more">Xem toàn bộ changelog</s:String>
    <s:String x:Key="up_show_less">Ẩn ghi chú phát hành</s:String>
    <s:String x:Key="up_loading_changelog">Đang tải...</s:String>
    <s:String x:Key="up_changelog_failed">Không thể tải toàn bộ changelog.</s:String>
    <s:String x:Key="up_release_notes_unavailable">Không có ghi chú phát hành nào được đăng.</s:String>
    <s:String x:Key="up_open_release">Mở trang phát hành</s:String>
    <!--#endregion -->

    <!--#region EnhanceVectorsPopup -->
    <s:String x:Key="pv_activate_pro">Kích hoạt WeMod Pro</s:String>
    <s:String x:Key="pv_devtools">DevTools bằng phím F12</s:String>
    <s:String x:Key="pv_disable_updates">Tắt cập nhật</s:String>
    <s:String x:Key="pv_remote_web_panel_preview">Bật truy cập từ xa (beta)</s:String>
    <s:String x:Key="pv_vietnamese">Giao diện tiếng Việt cho Wand</s:String>
    <s:String x:Key="pv_custom_scripts">Script tuỳ chỉnh</s:String>
    <s:String x:Key="pv_add_js_scripts">Thêm .js</s:String>
    <s:String x:Key="pv_custom_scripts_hint">Các file .js đã chọn sẽ được đóng gói vào Wand và chạy trong renderer.</s:String>
    <s:String x:Key="pv_no_custom_scripts">Chưa chọn script nào</s:String>
    <s:String x:Key="pv_start">Bắt đầu</s:String>
    <s:String x:Key="pv_auto_apply">Tự áp dụng sau khi cập nhật</s:String>
    <s:String x:Key="pv_popup_title">Hôm nay mình nâng cấp gì đây?</s:String>
    <s:String x:Key="pv_patch_method">Phương thức patch</s:String>
    <s:String x:Key="pv_strategy_static">Static (khuyên dùng)</s:String>
    <s:String x:Key="pv_strategy_supervised">Supervised (runtime)</s:String>
    <s:String x:Key="pv_strategy_hint">Static ghi thẳng vào Wand trên đĩa, làm hỏng chữ ký số của nó. Supervised patch trong bộ nhớ ở mỗi lần khởi động - có thể bị antivirus báo và không phải cấu hình nào cũng chạy được.</s:String>
    <!--#endregion -->

    <!--#region Runtime log -->
    <s:String x:Key="log_install_found">Đã tìm thấy thư mục WeMod tại {0} ({1})</s:String>
    <s:String x:Key="log_already_patched">WeMod đã được patch rồi. Nếu muốn patch lại, hãy hoàn nguyên backup trước đã.</s:String>
    <s:String x:Key="log_ready">Sẵn sàng để patch.</s:String>
    <s:String x:Key="log_install_not_found">Không tìm thấy thư mục WeMod.</s:String>
    <s:String x:Key="log_no_directory">Không thể thực hiện. Vui lòng chọn thư mục trước.</s:String>
    <s:String x:Key="log_invalid_directory">Thư mục {0} đã chọn không phải là thư mục WeMod hợp lệ.</s:String>
    <s:String x:Key="log_restore_failed">Hoàn nguyên backup thất bại: {0}</s:String>
    <s:String x:Key="log_patch_failed">Patch thất bại: {0}</s:String>
    <s:String x:Key="log_copied">Đã sao chép log vào bộ nhớ tạm.</s:String>
    <s:String x:Key="log_copy_failed">Sao chép log thất bại: {0}</s:String>
    <s:String x:Key="log_exported">Đã xuất log ra {0}.</s:String>
    <s:String x:Key="log_export_failed">Xuất log thất bại: {0}</s:String>
    <s:String x:Key="log_open_link_failed">Không thể mở {0} trong trình duyệt.</s:String>
    <s:String x:Key="dialog_pick_install">Chọn thư mục WeMod</s:String>
    <!--#endregion -->

</ResourceDictionary>
